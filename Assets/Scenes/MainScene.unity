  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Programming & Design\nJosh Wilger\n\n\n\n\n\n\nArt from OpenGameArt.org\n\n\n\n\n\n\nMusic\nWaterflame
    - Age of Flash\n\n\n\n\n\n\nTracks Used:\n\nWelcome to Metropolis\n\nTimeless
    Mountains\n\nEveryday Heroes\n\nIt's Time\n\nFireburst\n\nControl: Crowd (Newgrounds
    Mix)\n\nDark Seaside\n\nThe Other Side\n\nDeludebeats\n\nDark Dreams\n\nInvaders\n\nStrikebeam\n\nMonsterbreaks\n\nWhatever\n\nGray
    Morning\n\n\n\n\n\n\nGame Inspiration from Motherload \n(XGen Studios)\n\n\n\n\n\n\nSpecial
    thanks to the many playtesters \ninvolved and to York Burkhardt for \nasset contribution.\n\n\n\n\n\n\n\n\n\n\n\nCongratulations
    on completing my game!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3fd46b7b30dcb6b4db086832424216ab, type: 2}
